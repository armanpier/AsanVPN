# Telegram Bot Token (Get it from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Authorized Telegram Admin Chat IDs (comma-separated)
ADMIN_CHAT_IDS="123456789,987654321"

# Cloudflare Worker URL (e.g. https://your-worker.yoursubdomain.workers.dev or https://vpn-api.yourdomain.com)
WORKER_URL="https://asanvpn-worker.example.workers.dev"

# Secret Admin Token defined in wrangler.toml
ADMIN_TOKEN="CHANGEME_SECRET_ADMIN_TOKEN_9921"

# Optional Panel Direct Integrations
PANEL_TYPE="3xui" # 3xui | marzban | pasarguard | hiddify
PANEL_BASE_URL="https://panel.example.com"
PANEL_USERNAME="admin"
PANEL_PASSWORD="password"
