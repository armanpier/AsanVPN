# ====================================================
# AsanVPN Telegram Sales & Renewal Bot Configuration
# ====================================================

# Telegram Bot Token (Get from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_SAMPLE

# Bot Username without @
BOT_USERNAME=your_bot_username

# Admin Telegram IDs (comma-separated, optional)
ADMIN_IDS=123456789

# HooshPay Payment Gateway
HOOSHPAY_API_KEY=hp_live_your_api_key_here
HOOSHPAY_API_SECRET=your_api_secret_here
HOOSHPAY_BASE_URL=https://pay.hooshnet.com/api/v1

# AsanVPN Cloudflare Worker API
WORKER_URL=https://your-worker-subdomain.workers.dev
ADMIN_TOKEN=your_secure_worker_admin_token

# Support & Channels
SUPPORT_USERNAME=@YourSupportUsername
APP_DOWNLOAD_URL=https://github.com/your-username/AsanVPN/releases
